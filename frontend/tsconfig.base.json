{
  "compileOnSave": false,
  "compilerOptions": {
    "rootDir": ".",
    "sourceMap": true,
    "declaration": false,
    "moduleResolution": "bundler",
    "importHelpers": true,
    "target": "ES2022",
    "module": "preserve",
    "lib": ["ES2022", "dom"],
    "skipLibCheck": true,
    "isolatedModules": true,
    "experimentalDecorators": true,
    "strict": true,
    "noImplicitOverride": true,
    "noPropertyAccessFromIndexSignature": true,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noUncheckedIndexedAccess": true,
    "paths": {
      "@wallet/shared-util": ["./libs/shared/util/src/index.ts"],
      "@wallet/shared-domain": ["./libs/shared/domain/src/index.ts"],
      "@wallet/shared-ui": ["./libs/shared/ui/src/index.ts"],
      "@wallet/shared-data-access": ["./libs/shared/data-access/src/index.ts"],
      "@wallet/ingestion-domain": ["./libs/modules/ingestion/domain/src/index.ts"],
      "@wallet/ingestion-data-access": ["./libs/modules/ingestion/data-access/src/index.ts"],
      "@wallet/accounts-data-access": ["./libs/modules/accounts/data-access/src/index.ts"],
      "@wallet/accounts-domain": ["./libs/modules/accounts/domain/src/index.ts"],
      "@wallet/budgets-domain": ["./libs/modules/budgets/domain/src/index.ts"],
      "@wallet/budgets-data-access": ["./libs/modules/budgets/data-access/src/index.ts"],
      "@wallet/subscriptions-domain": ["./libs/modules/subscriptions/domain/src/index.ts"],
      "@wallet/subscriptions-data-access": [
        "./libs/modules/subscriptions/data-access/src/index.ts"
      ],
      "@wallet/onboarding-domain": ["./libs/modules/onboarding/domain/src/index.ts"],
      "@wallet/onboarding-data-access": ["./libs/modules/onboarding/data-access/src/index.ts"],
      "@wallet/user-domain": ["./libs/modules/user/domain/src/index.ts"],
      "@wallet/user-data-access": ["./libs/modules/user/data-access/src/index.ts"],
      "@wallet/core-shell": ["./libs/core/shell/src/index.ts"],
      "@wallet/overview-feature": ["./libs/modules/overview/feature/src/index.ts"],
      "@wallet/movements-feature": ["./libs/modules/movements/feature/src/index.ts"],
      "@wallet/budgets-ui": ["./libs/modules/budgets/ui/src/index.ts"],
      "@wallet/budgets-feature": ["./libs/modules/budgets/feature/src/index.ts"],
      "@wallet/subscriptions-ui": ["./libs/modules/subscriptions/ui/src/index.ts"],
      "@wallet/subscriptions-feature": ["./libs/modules/subscriptions/feature/src/index.ts"],
      "@wallet/upcoming-feature": ["./libs/modules/upcoming/feature/src/index.ts"],
      "@wallet/onboarding-feature": ["./libs/modules/onboarding/feature/src/index.ts"],
      "@wallet/settings-feature": ["./libs/modules/settings/feature/src/index.ts"],
      "@wallet/shared-ui/echarts": ["./libs/shared/ui/src/echarts.ts"]
    }
  },
  "exclude": ["node_modules", "tmp"]
}
