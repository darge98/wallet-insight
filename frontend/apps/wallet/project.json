{
  "name": "wallet",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "prefix": "app",
  "sourceRoot": "apps/wallet/src",
  "tags": ["scope:app", "type:app"],
  "targets": {
    "build": {
      "executor": "@angular/build:application",
      "outputs": ["{options.outputPath}"],
      "defaultConfiguration": "production",
      "options": {
        "outputPath": "dist/apps/wallet",
        "browser": "apps/wallet/src/main.ts",
        "tsConfig": "apps/wallet/tsconfig.app.json",
        "assets": [
          {
            "glob": "**/*",
            "input": "apps/wallet/public"
          }
        ],
        "styles": ["apps/wallet/src/styles.css"]
      },
      "configurations": {
        "production": {
          "budgets": [
            {
              "type": "initial",
              "maximumWarning": "600kB",
              "maximumError": "1.5MB"
            },
            {
              "type": "anyComponentStyle",
              "maximumWarning": "8kB",
              "maximumError": "16kB"
            }
          ],
          "outputHashing": "all",
          "optimization": {
            "scripts": true,
            "styles": {
              "minify": true,
              "inlineCritical": true
            },
            "fonts": {
              "inline": false
            }
          }
        },
        "development": {
          "optimization": false,
          "extractLicenses": false,
          "sourceMap": true
        },
        "preview": {
          "budgets": [],
          "outputHashing": "none",
          "extractLicenses": false,
          "sourceMap": false,
          "optimization": {
            "scripts": true,
            "styles": {
              "minify": true,
              "inlineCritical": true
            },
            "fonts": {
              "inline": false
            }
          }
        }
      }
    },
    "serve": {
      "continuous": true,
      "executor": "@angular/build:dev-server",
      "defaultConfiguration": "development",
      "configurations": {
        "production": {
          "buildTarget": "wallet:build:production"
        },
        "development": {
          "buildTarget": "wallet:build:development"
        }
      },
      "options": {
        "proxyConfig": "apps/wallet/proxy.conf.json"
      }
    },
    "test": {
      "executor": "@angular/build:unit-test",
      "options": {
        "watch": false
      }
    },
    "serve-static": {
      "continuous": true,
      "executor": "@nx/web:file-server",
      "options": {
        "buildTarget": "wallet:build",
        "staticFilePath": "dist/apps/wallet/browser",
        "spa": true
      }
    }
  }
}
